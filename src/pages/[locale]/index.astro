---
import {
	landingContentByLocale,
	locales,
	type Locale,
} from "@/data/landingContent";
import BaseLayout from "@/layouts/BaseLayout.astro";

export function getStaticPaths() {
	return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;

if (!locales.includes(locale)) {
	return Astro.redirect("/no", 302);
}

const t = landingContentByLocale[locale];
const nextLocale: Locale = locale === "no" ? "en" : "no";
const cvHref =
	locale === "no"
		? "/cv/ola-vassbotn-cv-no.pdf"
		: "/cv/ola-vassbotn-cv-en.pdf";
---

<BaseLayout lang={locale}>
	<header
		class="sticky top-0 z-20 border-b border-slate-200/80 bg-[rgb(244,246,248)]/95 backdrop-blur"
	>
		<div
			class="mx-auto flex w-full max-w-5xl items-center justify-between px-6 py-4"
		>
			<nav class="flex items-center gap-4 text-sm text-slate-700">
				<a href="#work" class="hover:text-slate-950">
					{t.nav.work}
				</a>
				<a href="#background" class="hover:text-slate-950">
					{t.nav.background}
				</a>
				<a href="#projects" class="hover:text-slate-950">
					{t.nav.projects}
				</a>
			</nav>
			<a
				href={`/${nextLocale}`}
				class="rounded-full border border-slate-300 px-3 py-1 text-xs font-medium text-slate-700 transition hover:border-slate-400 hover:text-slate-900"
			>
				{t.nav.languageSwitch}
			</a>
		</div>
	</header>
	<main class="mx-auto w-full max-w-5xl px-6 pb-20">
		<section class="subtle-rise pt-20">
			<h1
				class="text-4xl font-semibold tracking-tight text-slate-950 sm:text-6xl"
			>
				{t.name}
			</h1>
			<p class="mt-3 text-xl text-slate-700">{t.occupation}</p>
			<p class="mt-8 max-w-2xl text-lg leading-relaxed text-slate-700">
				{t.hero.summary}
			</p>
			<div class="mt-10 flex flex-wrap gap-3">
				<a
					href={cvHref}
					download
					class="rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-slate-800"
				>
					{t.hero.downloadCv}
				</a>
			</div>
		</section>

		<section id="work" class="subtle-rise mt-24">
			<h2 class="text-3xl font-semibold tracking-tight text-slate-950">
				{t.work.title}
			</h2>
			<div class="mt-8 grid gap-4">
				{
					t.work.items.map((item) => (
						<article class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
							<div class="flex flex-wrap items-baseline justify-between gap-2">
								<h3 class="text-lg font-medium text-slate-900">
									{item.role} · {item.company}
								</h3>
								<p class="text-sm text-slate-600">
									{item.period}
								</p>
							</div>
							<ul class="mt-3 list-disc space-y-1 pl-5 text-slate-700">
								{item.highlights.map((highlight) => (
									<li>{highlight}</li>
								))}
							</ul>
						</article>
					))
				}
			</div>
		</section>

		<section id="background" class="subtle-rise mt-24">
			<h2 class="text-3xl font-semibold tracking-tight text-slate-950">
				{t.background.title}
			</h2>
			<div class="mt-8 grid gap-4 md:grid-cols-2">
				<div
					class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"
				>
					<h3 class="text-lg font-medium text-slate-900">
						{t.background.educationTitle}
					</h3>
					<div class="mt-4 space-y-3">
						{
							t.background.education.map((item) => (
								<div>
									<p class="font-medium text-slate-800">
										{item.title}
									</p>
									<p class="text-slate-700">
										{item.subtitle}
									</p>
									<p class="text-sm text-slate-600">
										{item.period}
									</p>
								</div>
							))
						}
					</div>
				</div>
				<div
					class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"
				>
					<h3 class="text-lg font-medium text-slate-900">
						{t.background.leadershipTitle}
					</h3>
					<div class="mt-4 space-y-3">
						{
							t.background.leadership.map((item) => (
								<div>
									<p class="font-medium text-slate-800">
										{item.title}
									</p>
									<p class="text-slate-700">
										{item.subtitle}
									</p>
									<p class="text-sm text-slate-600">
										{item.period}
									</p>
								</div>
							))
						}
					</div>
				</div>
			</div>
		</section>

		<section id="projects" class="subtle-rise mt-24">
			<h2 class="text-3xl font-semibold tracking-tight text-slate-950">
				{t.projects.title}
			</h2>
			<div class="mt-8 grid gap-4 md:grid-cols-2">
				{
					t.projects.items.map((item) => (
						<article class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
							<h3 class="text-lg font-medium text-slate-900">
								{item.title}
							</h3>
							<p class="mt-2 text-slate-700">
								{item.description}
							</p>
							<p class="mt-3 text-sm text-slate-600">
								{item.stack}
							</p>
							<a
								href={item.link}
								target="_blank"
								rel="noopener noreferrer"
								class="mt-4 inline-flex text-sm font-medium text-slate-900 underline-offset-2 hover:underline"
							>
								{item.linkLabel}
							</a>
						</article>
					))
				}
			</div>
		</section>

		<footer class="mt-24 border-t border-slate-200 py-8">
			<h2 class="text-xl font-semibold text-slate-950">
				{t.contact.title}
			</h2>
			<div class="mt-4 flex flex-wrap gap-4 text-slate-700">
				<a href="mailto:ola@vassbotn.com" class="hover:text-slate-900">
					{t.contact.email}
				</a>
				<a
					href="https://www.linkedin.com/in/ola-vassbotn/"
					target="_blank"
					rel="noopener noreferrer"
					class="hover:text-slate-900"
				>
					{t.contact.linkedin}
				</a>
				<a
					href="https://github.com/olamva"
					target="_blank"
					rel="noopener noreferrer"
					class="hover:text-slate-900"
				>
					{t.contact.github}
				</a>
			</div>
		</footer>
	</main>
</BaseLayout>
